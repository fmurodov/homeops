{
  "annotations": {
    "list": []
  },
  "description": "Public NTP service ams1.ntp: talos1018's NTP dashboard without the Akvorado and VictoriaLogs rows (ocivm-1 has neither). Clock health and upstream sources from chrony_exporter, server counters from chrony serverstats.",
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 40,
  "tags": [
    "ntp",
    "chrony"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "regex": "VictoriaMetrics",
        "current": {},
        "options": [],
        "refresh": 1,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "query": {
          "query": "label_values(chrony_up, pod)",
          "refId": "V"
        },
        "definition": "label_values(chrony_up, pod)",
        "current": {},
        "options": [],
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "NTP (chrony)",
  "uid": "ntp",
  "version": 1,
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Clock health (chrony_exporter)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Exporter up",
      "description": "chrony_up per pod: 0 means the exporter could not talk to chronyd.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "min(chrony_up{pod=~\"$pod\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Stratum",
      "description": "Highest stratum across the pods. 16 means unsynchronised.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "max(chrony_tracking_stratum{pod=~\"$pod\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "red",
                "value": 16
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Max clock error",
      "description": "Worst pod: |last offset| + root dispersion + root delay / 2, the bound chronyc documents.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "max(abs(chrony_tracking_last_offset_seconds{pod=~\"$pod\"}) + chrony_tracking_root_dispersion_seconds{pod=~\"$pod\"} + 0.5 * chrony_tracking_root_delay_seconds{pod=~\"$pod\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "System clock offset",
      "description": "Worst pod: how far the kernel clock is from chrony's estimate of true time. Positive is fast.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "max(abs(chrony_tracking_system_time_seconds{pod=~\"$pod\"}))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Selected sources",
      "description": "Sources in state sync across the pods (one per pod when healthy).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "count(chrony_sources_state_info{pod=~\"$pod\",source_state=\"sync\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Unreachable sources",
      "description": "Sources whose last 8 polls all failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "count(chrony_sources_reachability_ratio{pod=~\"$pod\"} == 0) or vector(0)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 17,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "table",
      "id": 8,
      "title": "Reference per pod",
      "description": "The source each pod is synchronised to.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "chrony_tracking_info{pod=~\"$pod\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "app_kubernetes_io_name": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "tracking_address": true,
              "tracking_refid": true
            },
            "renameByName": {
              "tracking_name": "reference"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "System clock offset",
      "description": "chrony_tracking_system_time_seconds. chronyd runs with -x, so it measures the node clock but does not steer it; Talos' own timesyncd does.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "chrony_tracking_system_time_seconds{pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Clock error bound",
      "description": "|last offset| + root dispersion + root delay / 2 per pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "abs(chrony_tracking_last_offset_seconds{pod=~\"$pod\"}) + chrony_tracking_root_dispersion_seconds{pod=~\"$pod\"} + 0.5 * chrony_tracking_root_delay_seconds{pod=~\"$pod\"}",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Last and RMS offset",
      "description": "Offset of the last clock update, and its long-term RMS.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "chrony_tracking_last_offset_seconds{pod=~\"$pod\"}",
          "legendFormat": "last {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        },
        {
          "expr": "chrony_tracking_rms_offset_seconds{pod=~\"$pod\"}",
          "legendFormat": "rms {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Root delay and dispersion",
      "description": "Round trip and accumulated error back to the stratum 1 servers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "chrony_tracking_root_delay_seconds{pod=~\"$pod\"}",
          "legendFormat": "delay {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        },
        {
          "expr": "chrony_tracking_root_dispersion_seconds{pod=~\"$pod\"}",
          "legendFormat": "dispersion {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Frequency",
      "description": "Frequency error of the node clock, and how uncertain it is (skew).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "chrony_tracking_frequency_ppms{pod=~\"$pod\"}",
          "legendFormat": "freq {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "A"
        },
        {
          "expr": "chrony_tracking_skew_ppms{pod=~\"$pod\"}",
          "legendFormat": "skew {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 14,
      "title": "Upstream sources",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "type": "table",
      "id": 15,
      "title": "Sources",
      "description": "State, stratum, reach and the last sample of every upstream source, per pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "expr": "chrony_sources_stratum{pod=~\"$pod\"} * on (pod, source_address, source_name) group_left (source_state, source_mode) chrony_sources_state_info{pod=~\"$pod\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "chrony_sources_reachability_ratio{pod=~\"$pod\"} * on (pod, source_address, source_name) group_left (source_state, source_mode) chrony_sources_state_info{pod=~\"$pod\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "chrony_sources_last_sample_offset_seconds{pod=~\"$pod\"} * on (pod, source_address, source_name) group_left (source_state, source_mode) chrony_sources_state_info{pod=~\"$pod\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "chrony_sources_last_sample_error_margin_seconds{pod=~\"$pod\"} * on (pod, source_address, source_name) group_left (source_state, source_mode) chrony_sources_state_info{pod=~\"$pod\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "chrony_sources_polling_interval_seconds{pod=~\"$pod\"} * on (pod, source_address, source_name) group_left (source_state, source_mode) chrony_sources_state_info{pod=~\"$pod\"}",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_VM}"
          },
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "reach"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "offset"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error margin"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "poll"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "app_kubernetes_io_name": true,
              "instance": true,
              "job": true,
              "namespace": true
            },
            "indexByName": {
              "pod": 0,
              "source_name": 1,
              "source_address": 2,
              "source_state": 3,
              "source_mode": 4
            },
            "renameByName": {
              "source_name": "name",
              "source_address": "address",
              "source_state": "state",
              "source_mode": "mode",
              "Value #B": "stratum",
              "Value #C": "reach",
              "Value #D": "offset",
              "Value #E": "error margin",
