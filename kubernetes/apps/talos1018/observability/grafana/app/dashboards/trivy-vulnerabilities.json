          "expr": "count(count by (vuln_id) (trivy_vulnerability_id{namespace=~\"$namespace\", severity=\"High\", image_repository=~\"$image\", vuln_id=~\"(?i).*${cve}.*\", vuln_score=~\"${score}\"}))",
          "instant": true,
          "range": false,
          "refId": "A"
