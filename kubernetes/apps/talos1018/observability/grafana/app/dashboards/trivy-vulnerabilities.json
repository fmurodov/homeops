        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (namespace, resource_kind, resource_name) (trivy_image_vulnerabilities{namespace=~\"$namespace\", image_repository=~\"$image\"}))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Scanned workloads",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One row per CVE. Click a Vulnerability to open the advisory or filter the dashboard to it. Column headers sort; the funnel icon filters.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "High": {
                        "color": "orange",
                        "index": 1
                      },
                      "Low": {
                        "color": "blue",
                        "index": 3
                      },
                      "Medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "Unknown": {
                        "color": "text",
                        "index": 4
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "displayName",
                "value": "Severity"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vuln_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Open advisory (${__data.fields.vuln_id})",
                    "url": "${__data.fields.url}"
                  },
                  {
                    "title": "Show every image with ${__data.fields.vuln_id}",
                    "url": "/d/trivy-vulns/trivy-vulnerabilities?${__url_time_range}&${namespace:queryparam}&${severity:queryparam}&${image:queryparam}&${score:queryparam}&var-cve=${__data.fields.vuln_id}"
                  },
                  {
                    "targetBlank": true,
                    "title": "NVD entry",
                    "url": "https://nvd.nist.gov/vuln/detail/${__data.fields.vuln_id}"
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "Vulnerability"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vuln_score"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Score"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 4
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "red",
                      "value": 9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Findings"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Score"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (vuln_id, url, severity, vuln_score, vuln_title) (label_replace(label_replace(label_lowercase(label_copy(trivy_vulnerability_id{namespace=~\"$namespace\", severity=~\"$severity\", image_repository=~\"$image\", vuln_id=~\"(?i).*${cve}.*\", vuln_score=~\"${score}\"}, \"vuln_id\", \"vid\"), \"vid\"), \"url\", \"https://avd.aquasec.com/nvd/$1\", \"vid\", \"(cve-.*)\"), \"url\", \"https://github.com/advisories/$1\", \"vuln_id\", \"(GHSA-.*)\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Vulnerabilities",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value": 4,
              "severity": 0,
              "url": 5,
              "vuln_id": 1,
              "vuln_score": 2,
              "vuln_title": 3
            },
            "renameByName": {
              "Value": "Findings",
              "vuln_title": "Title"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "destinationType": "number",
                "targetField": "vuln_score"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
