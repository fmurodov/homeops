      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Workloads with a VulnerabilityReport, vulnerable or not",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "text",
