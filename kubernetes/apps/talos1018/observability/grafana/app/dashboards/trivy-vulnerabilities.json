      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, image_registry, image_repository, image_tag) (trivy_image_vulnerabilities{namespace=~\"$namespace\", image_repository=~\"$image\", severity=\"Critical\"})",
          "format": "table",
          "instant": true,
