          "expr": "max by (namespace, resource_kind, resource_name, container_name, image_registry, image_repository, image_tag, resource, installed_version, fixed_version, severity, vuln_score, vuln_id, url, vuln_title, published_date) (label_replace(label_replace(label_lowercase(label_copy(trivy_vulnerability_id{namespace=~\"$namespace\", severity=~\"$severity\", image_repository=~\"$image\", vuln_id=~\"(?i).*${cve}.*\", vuln_score=~\"${score}\"}, \"vuln_id\", \"vid\"), \"vid\"), \"url\", \"https://avd.aquasec.com/nvd/$1\", \"vid\", \"(cve-.*)\"), \"url\", \"https://github.com/advisories/$1\", \"vuln_id\", \"(GHSA-.*)\"))",
