{
  "description": "Per-CVE table view of trivy-operator VulnerabilityReports (needs OPERATOR_METRICS_VULN_ID_ENABLED).",
  "editable": true,
  "graphTooltip": 0,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Trivy Operator overview",
      "type": "link",
      "url": "/d/ycwPj724k/trivy-operator-dashboard"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Distinct vulnerabilities, not findings",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "dark-red",
            "mode": "fixed"
          },
          "noValue": "0",
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (vuln_id) (trivy_vulnerability_id{namespace=~\"$namespace\", severity=\"Critical\", image_repository=~\"$image\", vuln_id=~\"(?i).*${cve}.*\", vuln_score=~\"${score}\"}))",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Critical CVEs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Distinct vulnerabilities, not findings",
