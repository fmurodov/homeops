    {
      "type": "timeseries",
      "id": 4,
      "title": "By home network",
      "description": "Bits per second by VLAN (Akvorado network name): downloads to each network plus uploads from it. Gateway IPFIX, 1:16 random sampling, scaled. Routed VLAN-to-VLAN traffic is not exported.",
