  "title": "Akvorado flows",
  "uid": "akvorado-flows",
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "WAN traffic",
      "description": "Bits per second crossing the WAN: inbound positive, outbound negative. Gateway IPFIX, 1:16 random sampling, scaled. Routed VLAN-to-VLAN traffic is not exported.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "akvorado"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "akvorado"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeReceived) AS time, 'in' AS d, sum(Bytes * SamplingRate) * 8 / $__interval_s AS bps FROM flows_1m0s WHERE $__timeFilter(TimeReceived) AND InIfBoundary = 'external' AND EType IN (${family:csv}) GROUP BY time ORDER BY time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "akvorado"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeReceived) AS time, 'out' AS d, -sum(Bytes * SamplingRate) * 8 / $__interval_s AS bps FROM flows_1m0s WHERE $__timeFilter(TimeReceived) AND OutIfBoundary = 'external' AND EType IN (${family:csv}) GROUP BY time ORDER BY time",
          "refId": "B"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "By IP family",
      "description": "WAN bits per second by family, both directions together. Gateway IPFIX, 1:16 random sampling, scaled. Routed VLAN-to-VLAN traffic is not exported.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "akvorado"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "akvorado"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeReceived) AS time, if(EType = 2048, 'IPv4', 'IPv6') AS family, sum(Bytes * SamplingRate) * 8 / $__interval_s AS bps FROM flows_1m0s WHERE $__timeFilter(TimeReceived) AND (InIfBoundary = 'external' OR OutIfBoundary = 'external') AND EType IN (${family:csv}) GROUP BY time, family ORDER BY time",
          "refId": "A"
        }
      ],
