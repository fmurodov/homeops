        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${DS_VICTORIALOGS}"
          },
          "editorMode": "code",
          "expr": "_stream: {kubernetes_container_name=\"cilium-envoy\"} response_code:* authority:~\"^$host$\" $query | stats count() total, count() if (response_code:range[500, 600)) errors | math errors / total * 100 as pct | fields pct",
