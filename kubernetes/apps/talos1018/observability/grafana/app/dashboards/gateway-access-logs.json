    {
      "type": "timeseries",
      "title": "Requests by status class",
      "id": 9,
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${DS_VICTORIALOGS}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "pluginVersion": "11.5.1",
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${DS_VICTORIALOGS}"
          },
          "editorMode": "code",
          "expr": "_stream: {kubernetes_container_name=\"cilium-envoy\"} response_code:* authority:~\"^$host$\" $query | extract_regexp '(?P<class>^.)' from response_code | stats by (class) count() c",
          "queryType": "statsRange",
          "refId": "A",
          "legendFormat": "{{class}}xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "0xx is Envoy's code for a request that never got a response, usually a client disconnect."
    },
