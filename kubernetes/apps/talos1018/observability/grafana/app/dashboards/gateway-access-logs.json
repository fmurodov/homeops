          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${DS_VICTORIALOGS}"
          },
          "editorMode": "code",
          "expr": "_stream: {kubernetes_container_name=\"cilium-envoy\"} response_code:* authority:~\"^$host$\" $query NOT path:~'[.](ico|svg|css|png|jpg|jpeg|gif|woff2?|js|map|xml|txt)$' | stats by (path) count() c | sort by (c desc) | limit 20",
          "queryType": "stats",
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "Field": "Path",
              "Last *": "Requests"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Last *",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
