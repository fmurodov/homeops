{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      // talconfig.yaml and the KubernetesUpgrade both pin ghcr.io/siderolabs/kubelet;
      // Talos derives the other component images from kubernetesVersion itself
      minimumGroupSize: 2,
    },
    {
      description: "Talos Group",
      groupName: "talos",
      // github-releases so PRs carry the Talos release notes; the kubelet/installer
      // images publish no release bodies of their own
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/installer/", "siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Group",
      groupName: "flux",
      matchDatasources: ["docker", "github-releases"],
      matchPackageNames: ["/flux/", "/fluxcd/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "app-template Group",
      groupName: "app-template",
      // The same chart reaches this repo two ways: `helm` for the HelmReleases
      // backed by the bjw-s HelmRepository, and `docker` for the OCIRepository
      // tags. Ungrouped they arrive as two PRs for one upstream release.
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["/app-template$/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
  ],
}
