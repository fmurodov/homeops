{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Automerge temporarily disabled - re-enable by setting automerge: true below
  packageRules: [
    {
      description: "Auto-merge patch versions",
      matchUpdateTypes: ["patch"],
      automerge: false,
      automergeType: "pr",
      platformAutomerge: true,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Auto-merge trusted container digests",
      matchDatasources: ["docker"],
      automerge: false,
      automergeType: "pr",
      platformAutomerge: true,
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: false,
      automergeType: "pr",
      platformAutomerge: true,
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: [
        "/^actions\\/",
        "/^renovatebot\\/",
        "/^anthropics\\/",
      ],
      automerge: false,
      automergeType: "pr",
      platformAutomerge: true,
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "1 day",
    },
    {
      description: "Automerge listed apps",
      // To automerge another app, add its package name here. Renovate merges
      // only after every check on the PR passes: the branch ruleset requires
      // none, so GitHub auto-merge (platformAutomerge) would merge at once.
      matchPackageNames: [
        "LomotHo/minecraft-bedrock",
        "itzg/minecraft-bedrock-server",
      ],
      automerge: true,
      automergeType: "pr",
      automergeStrategy: "squash",
      platformAutomerge: false,
      minimumReleaseAge: null,
    },
  ],
}
