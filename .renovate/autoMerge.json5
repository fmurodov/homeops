{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Renovate merges these PRs itself, only after every check on the PR passes.
  // platformAutomerge stays off: the ruleset requires only manifests and
  // gitleaks, so GitHub auto-merge would not wait for validate-talos.
  //
  // minimumReleaseAge needs a release date. Docker Hub, Helm repositories and
  // tagged GitHub Actions have one; ghcr.io, quay.io and OCI charts don't, so
  // their updates stay pending on renovate/stability-days and are never
  // automerged (minimumReleaseAgeBehaviour: timestamp-required, the default).
  packageRules: [
    {
      description: "Automerge digest and patch updates after 3 days",
      matchUpdateTypes: ["digest", "pinDigest", "patch"],
      automerge: true,
      automergeType: "pr",
      automergeStrategy: "squash",
      platformAutomerge: false,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Automerge GitHub Actions minor updates too",
      // CI only; a bad action shows up as a red check, not a broken cluster
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      automergeStrategy: "squash",
      platformAutomerge: false,
      minimumReleaseAge: "3 days",
    },
    {
      description: "Never automerge the platform or databases",
      // Talos and Kubernetes roll every node, the CNI/storage/GitOps layers
      // take the whole cluster with them, and a database can't be rolled back
      // once it has migrated its data.
      matchPackageNames: [
        "/siderolabs/",
        "/registry\\.k8s\\.io/",
        "/cilium/",
        "/fluxcd/",
        "/longhorn/",
        "/cert-manager/",
        "/gateway-api/",
        "/multus/",
        "/postgres/",
        "/clickhouse/",
        "/valkey/",
        "/kafka/",
        "gitea",
      ],
      automerge: false,
    },
    {
      description: "Automerge listed apps",
      // To automerge every update of an app (minor and major too, no release
      // age), add its package name here.
      matchPackageNames: [
        "LomotHo/minecraft-bedrock",
        "itzg/minecraft-bedrock-server",
      ],
      automerge: true,
      automergeType: "pr",
      automergeStrategy: "squash",
      platformAutomerge: false,
      minimumReleaseAge: null,
    },
  ],
}
